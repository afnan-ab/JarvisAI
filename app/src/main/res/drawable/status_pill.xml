<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#B5061019"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="#245D76"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#102A3A" android:endColor="#050C13" android:angle="0"/>
            <corners android:radius="19dp"/>
        </shape>
    </item>
</layer-list>