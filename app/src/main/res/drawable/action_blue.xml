<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#99101D2A"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#287C9D"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#19364A" android:endColor="#08121D" android:angle="270"/>
            <corners android:radius="15dp"/>
            <stroke android:width="1dp" android:color="#163D52"/>
        </shape>
    </item>
</layer-list>