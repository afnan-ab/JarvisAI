            <gradient android:startColor="#8C6CFF" android:centerColor="#38258A" android:endColor="#080C18" android:type="radial" android:gradientRadius="90dp" />
            <stroke android:width="1dp" android:color="#B8A5FF" />
        </shape>
    </item>
    <item android:left="34dp" android:top="34dp" android:right="34dp" android:bottom="34dp">
