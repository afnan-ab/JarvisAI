<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0B0F14"
    android:padding="16dp"
    android:elevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/overlayOrb"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/orb_calm" />

        <TextView
            android:id="@+id/overlayStateLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Jarvis"
            android:textColor="#7C5CFF"
            android:textStyle="bold"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/overlayCloseButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlayReplyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bubble_jarvis"
        android:padding="12dp"
        android:textColor="#5FD3FF"
        android:text="Listening..."
        android:maxLines="6" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/overlayInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Tell Jarvis..."
            android:textColorHint="#4A5568"
            android:textColor="#FFFFFF"
            android:background="@drawable/input_bg"
            android:padding="10dp" />

        <ImageButton
            android:id="@+id/overlayMicButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/mic_bg"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Voice input" />

        <ImageButton
            android:id="@+id/overlaySendButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/send_bg"
            android:src="@android:drawable/ic_menu_send"
            android:contentDescription="Send" />
    </LinearLayout>
</LinearLayout>
