<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#02060B">

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#16BFFF"
        android:alpha="0.8"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="JARVIS"
        android:textColor="#35D7FF"
        android:textSize="29sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/greetingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Your Personal AI Assistant"
        android:textColor="#9BB7C8"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/titleLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="21dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/glass_panel"
        android:contentDescription="Settings"
        android:src="@android:drawable/ic_menu_manage"
        android:tint="#D9F6FF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/orbFrame"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginTop="13dp"
        app:layout_constraintTop_toBottomOf="@id/greetingLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:background="@drawable/orb_calm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="J"
            android:textColor="#E6FBFF"
            android:textSize="58sp"
            android:textStyle="bold"
            android:shadowColor="#2BD8FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="18" />

        <View
            android:id="@+id/orb"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:alpha="0.72" />
    </FrameLayout>

    <TextView
        android:id="@+id/stateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="●  System Online"
        android:textColor="#19E98A"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/orbFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/moodLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Ready to assist you"
        android:textColor="#9BC7DA"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/stateLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/statusPill"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/status_pill"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/moodLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/statusDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◉"
                android:textColor="#21DFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/stateHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="“Hello, I am JARVIS.\nHow can I help you today?”"
                android:textColor="#D5EAF4"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌁ )))"
                android:textColor="#18CFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <GridLayout
        android:id="@+id/quickGrid"
        android:layout_width="0dp"
        android:layout_height="122dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="18dp"
        android:columnCount="3"
        android:rowCount="2"
        android:useDefaultMargins="false"
        app:layout_constraintTop_toBottomOf="@id/statusPill"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/voiceQuickButton"
            style="@style/JarvisQuickButton"
            android:text="🎙\nVoice" />

        <TextView
            android:id="@+id/typeQuickButton"
            style="@style/JarvisQuickButton"
            android:text="⌨\nType" />

        <TextView
            android:id="@+id/cameraQuickButton"
            style="@style/JarvisQuickButton"
            android:text="▣\nCamera" />

        <TextView
            android:id="@+id/appsQuickButton"
            style="@style/JarvisQuickButton"
            android:text="▦\nApps" />

        <TextView
            android:id="@+id/toolsQuickButton"
            style="@style/JarvisQuickButton"
            android:text="⚙\nTools" />

        <TextView
            android:id="@+id/settingsQuickButton"
            style="@style/JarvisQuickButton"
            android:text="⚙\nSettings" />
    </GridLayout>

    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/status_pill"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/quickGrid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/listeningIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▮▮▮  Listening..."
            android:textColor="#20DFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="  Type a command..."
            android:hintTextColor="#49687B"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:textColor="#EAFBFF"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/mic_bg"
            android:contentDescription="Voice input"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#DDFBFF" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/send_bg"
            android:contentDescription="Send"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#EFFFFF" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/clearButton"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="Clear chat"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="#4D7082"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecycler"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/inputBar" />

</androidx.constraintlayout.widget.ConstraintLayout>