<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#02070D">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#35D9FF"
        android:alpha="0.85"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="@drawable/glass_panel"
        android:alpha="0.18"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/titleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="17dp"
        android:text="J A R V I S"
        android:textColor="#C9F7FF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.13"
        android:shadowColor="#2BD9FF"
        android:shadowRadius="9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/greetingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        android:text="PERSONAL AI ASSISTANT  //  ONLINE"
        android:textColor="#5E9CB1"
        android:textSize="8sp"
        android:letterSpacing="0.08"
        app:layout_constraintTop_toBottomOf="@id/titleLabel"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/systemChip"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="17dp"
        android:background="@drawable/status_pill"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="●  SYSTEM ONLINE"
        android:textColor="#4BEEB0"
        android:textSize="8sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="51dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/glass_panel"
        android:contentDescription="Settings"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_manage"
        android:tint="#BDEFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <FrameLayout
        android:id="@+id/orbFrame"
        android:layout_width="224dp"
        android:layout_height="224dp"
        android:layout_marginTop="11dp"
        app:layout_constraintTop_toBottomOf="@id/greetingLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="224dp"
            android:layout_height="224dp"
            android:background="@drawable/orb_calm"/>

        <View
            android:layout_width="188dp"
            android:layout_height="188dp"
            android:layout_gravity="center"
            android:background="@drawable/orb_listening"
            android:alpha="0.16"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="J"
            android:textColor="#E9FCFF"
            android:textSize="66sp"
            android:textStyle="bold"
            android:shadowColor="#35DFFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20"/>

        <View
            android:id="@+id/orb"
            android:layout_width="224dp"
            android:layout_height="224dp"
            android:alpha="0.72"/>
    </FrameLayout>

    <TextView
        android:id="@+id/stateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="●  SYSTEM ONLINE"
        android:textColor="#36E7A1"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/orbFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/moodLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="READY TO ASSIST"
        android:textColor="#6E9CAF"
        android:textSize="8sp"
        android:letterSpacing="0.14"
        app:layout_constraintTop_toBottomOf="@id/stateLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/statusPill"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/status_pill"
        android:gravity="center_vertical"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        app:layout_constraintTop_toBottomOf="@id/moodLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/statusDot"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/glass_panel"
            android:gravity="center"
            android:text="◉"
            android:textColor="#4AE6FF"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/stateHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="“Hello, I am JARVIS.\nHow can I help you today?”"
            android:textColor="#D7EFF7"
            android:textSize="10sp"
            android:lineSpacingExtra="2dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀ )))"
            android:textColor="#27DFFF"
            android:textSize="11sp"
            android:alpha="0.9"/>
    </LinearLayout>

    <TextView
        android:id="@+id/quickActionsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:text="QUICK ACTIONS"
        android:textColor="#5FA4B8"
        android:textSize="8sp"
        android:textStyle="bold"
        android:letterSpacing="0.16"
        app:layout_constraintTop_toBottomOf="@id/statusPill"
        app:layout_constraintStart_toStartOf="parent"/>

    <GridLayout
        android:id="@+id/quickGrid"
        android:layout_width="0dp"
        android:layout_height="116dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="15dp"
        android:columnCount="3"
        android:rowCount="2"
        android:useDefaultMargins="false"
        app:layout_constraintTop_toBottomOf="@id/quickActionsLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/voiceQuickButton"
            style="@style/JarvisQuickButton"
            android:text="◉\nVOICE"/>

        <TextView
            android:id="@+id/typeQuickButton"
            style="@style/JarvisQuickButton"
            android:text="⌨\nTYPE"/>

        <TextView
            android:id="@+id/cameraQuickButton"
            style="@style/JarvisQuickButton"
            android:text="◇\nCAMERA"/>

        <TextView
            android:id="@+id/appsQuickButton"
            style="@style/JarvisQuickButton"
            android:text="▦\nAPPS"/>

        <TextView
            android:id="@+id/toolsQuickButton"
            style="@style/JarvisQuickButton"
            android:text="⌁\nTOOLS"/>

        <TextView
            android:id="@+id/settingsQuickButton"
            style="@style/JarvisQuickButton"
            android:text="⚙\nSETTINGS"/>
    </GridLayout>

    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/status_pill"
        android:gravity="center_vertical"
        android:paddingStart="7dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/listeningIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="▮▮▮"
            android:textColor="#20DFFF"
            android:textSize="9sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="  COMMAND..."
            android:textColorHint="#416779"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="1"
            android:paddingStart="5dp"
            android:textColor="#EAFBFF"
            android:textSize="11sp"/>

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/mic_bg"
            android:contentDescription="Voice input"
            android:padding="9dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#DDFBFF"/>

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/send_bg"
            android:contentDescription="Send"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#EFFFFF"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecycler"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/inputBar"/>

</androidx.constraintlayout.widget.ConstraintLayout>