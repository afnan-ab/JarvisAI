<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03070D">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/titleLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="JARVIS"
            android:textColor="#F5FAFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/onlineLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="● ONLINE"
            android:textColor="#39E58C"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/clearButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/glass_panel"
            android:contentDescription="Clear chat"
            android:src="@android:drawable/ic_menu_delete" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/glass_panel"
            android:contentDescription="Settings"
            android:src="@android:drawable/ic_menu_manage" />
    </LinearLayout>

    <TextView
        android:id="@+id/greetingLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:text="Good evening. I'm JARVIS."
        android:textColor="#DDE9F5"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/orb"
        android:layout_width="158dp"
        android:layout_height="158dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/orb_calm"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/greetingLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/stateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="System Online"
        android:textColor="#39E58C"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/orb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/moodLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Ready to assist you"
        android:textColor="#73BCE8"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/stateLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/quickRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/moodLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/voiceQuickButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/action_blue"
            android:gravity="center"
            android:text="🎙  Voice"
            android:textColor="#EAF8FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/typeQuickButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/action_blue"
            android:gravity="center"
            android:text="⌨  Type"
            android:textColor="#EAF8FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/toolsQuickButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/action_green"
            android:gravity="center"
            android:text="⚙  Tools"
            android:textColor="#EAF8FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statusPill"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/status_pill"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintTop_toBottomOf="@id/quickRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/statusDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#39E58C"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Listening for your command..."
            android:textColor="#B8D9EC"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/stateHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READY"
            android:textColor="#48CFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/statusPill"
        app:layout_constraintBottom_toTopOf="@id/inputBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#050A12"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Talk to JARVIS..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:textColor="#FFFFFF"
            android:textColorHint="#60758A"
            android:background="@drawable/input_bg"
            android:paddingStart="16dp"
            android:paddingEnd="12dp" />

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/mic_bg"
            android:contentDescription="Voice input"
            android:src="@android:drawable/ic_btn_speak_now" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/send_bg"
            android:contentDescription="Send"
            android:src="@android:drawable/ic_menu_send" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>